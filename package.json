{
  "name": "gossamer-preview",
  "displayName": "Gossamer Preview",
  "description": "Instantly preview AI-generated HTML files in Cursor/VS Code with live reload, find-in-page, zoom, and source editing",
  "version": "2.0.4",
  "publisher": "ashvinbondada",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onCommand:gossamer-preview.open",
    "onCustomEditor:gossamer-preview.html"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "vscode:prepublish": "npm run compile",
    "test:unit": "tsc -p ./ && mocha --recursive 'out/test/unit/**/*.test.js' --timeout 10000",
    "test:integration": "tsc -p ./ && node ./out/test/integration/runTest.js",
    "test": "npm run test:unit && npm run test:integration"
  },
  "contributes": {
    "commands": [
      {
        "command": "gossamer-preview.open",
        "title": "Gossamer Preview: Open Current HTML File"
      },
      {
        "command": "gossamer-preview.compareFiles",
        "title": "Gossamer Preview: Compare HTML Files"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gossamer-preview.open",
          "when": "resourceLangId == html || resourceExtname == .html"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "gossamer-preview.html",
        "displayName": "Gossamer Preview",
        "selector": [
          {
            "filenamePattern": "*.html"
          },
          {
            "filenamePattern": "*.htm"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Gossamer Preview",
      "properties": {
        "gossamer-preview.telemetry.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Send anonymous usage and error telemetry to help improve Gossamer Preview. We collect: extension version, preview opened/closed events, shortcut usage, and errors. We never collect: file contents, file paths, or anything that identifies you personally. The identifier is VS Code's anonymous machineId. Honored alongside the global VS Code telemetry setting — if either is off, no events are sent."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ashvinbondada/gossamer-preview.git"
  },
  "homepage": "https://github.com/ashvinbondada/gossamer-preview",
  "bugs": {
    "url": "https://github.com/ashvinbondada/gossamer-preview/issues"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/jsdom": "^28.0.3",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^2.22.0",
    "glob": "^8.1.0",
    "jsdom": "^29.1.1",
    "mocha": "^10.2.0",
    "playwright": "^1.60.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "posthog-node": "^5.35.13"
  }
}
