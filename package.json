{
  "name": "gossamer-preview",
  "displayName": "Gossamer Preview",
  "description": "Instantly preview AI-generated HTML files in the Cursor/VS Code Simple Browser without leaving your editor",
  "version": "2.0.2",
  "publisher": "ashvinbondada",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onCommand:gossamer-preview.open",
    "onCustomEditor:gossamer-preview.html"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "vscode:prepublish": "npm run compile",
    "test:unit": "tsc -p ./ && mocha --recursive 'out/test/unit/**/*.test.js' --timeout 10000",
    "test:integration": "tsc -p ./ && node ./out/test/integration/runTest.js",
    "test": "npm run test:unit && npm run test:integration"
  },
  "contributes": {
    "commands": [
      {
        "command": "gossamer-preview.open",
        "title": "Gossamer Preview: Open Current HTML File"
      },
      {
        "command": "gossamer-preview.compareFiles",
        "title": "Gossamer Preview: Compare HTML Files"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gossamer-preview.open",
          "when": "resourceLangId == html || resourceExtname == .html"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "gossamer-preview.html",
        "displayName": "Gossamer Preview",
        "selector": [
          { "filenamePattern": "*.html" },
          { "filenamePattern": "*.htm" }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Gossamer Preview",
      "properties": {
        "gossamer-preview.openEditor": {
          "type": "boolean",
          "default": false,
          "description": "Also open the HTML file in the text editor alongside Simple Browser. When false, only Simple Browser opens."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ashvinbondada/gossamer-preview.git"
  },
  "homepage": "https://github.com/ashvinbondada/gossamer-preview",
  "bugs": {
    "url": "https://github.com/ashvinbondada/gossamer-preview/issues"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^20.0.0",
    "@types/mocha": "^10.0.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^2.22.0",
    "mocha": "^10.2.0",
    "@vscode/test-electron": "^2.3.0",
    "glob": "^8.1.0",
    "@types/glob": "^8.1.0"
  }
}
